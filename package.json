{
  "name": "realtime-voice",
  "version": "0.1.0",
  "description": "Headless voice-to-voice agent for React Native / Expo, powered by the OpenAI Realtime API over WebRTC. Ephemeral-token auth, colocated tool calling, optional themed UI.",
  "keywords": [
    "openai",
    "realtime",
    "voice",
    "voice-agent",
    "webrtc",
    "react-native",
    "expo",
    "speech-to-speech"
  ],
  "license": "MIT",
  "author": "Tejasvi Raj",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tejasvi8686/realtime-voice.git"
  },
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./ui": {
      "react-native": "./src/ui/index.ts",
      "import": {
        "types": "./lib/typescript/module/ui/index.d.ts",
        "default": "./lib/module/ui/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/ui/index.d.ts",
        "default": "./lib/commonjs/ui/index.js"
      }
    },
    "./webrtc/livekit": {
      "react-native": "./src/webrtc/livekit.ts",
      "import": {
        "types": "./lib/typescript/module/webrtc/livekit.d.ts",
        "default": "./lib/module/webrtc/livekit.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/webrtc/livekit.d.ts",
        "default": "./lib/commonjs/webrtc/livekit.js"
      }
    },
    "./webrtc/rn": {
      "react-native": "./src/webrtc/rn.ts",
      "import": {
        "types": "./lib/typescript/module/webrtc/rn.d.ts",
        "default": "./lib/module/webrtc/rn.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/webrtc/rn.d.ts",
        "default": "./lib/commonjs/webrtc/rn.js"
      }
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "plugin",
    "examples",
    "app.plugin.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "test": "node test/run.cjs",
    "clean": "rm -rf lib",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run build && npm test",
    "prepare": "bob build"
  },
  "peerDependencies": {
    "@livekit/react-native-webrtc": "*",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-incall-manager": "*",
    "react-native-webrtc": "*",
    "zod": ">=3.22.0"
  },
  "peerDependenciesMeta": {
    "@livekit/react-native-webrtc": {
      "optional": true
    },
    "react-native-webrtc": {
      "optional": true
    },
    "react-native-incall-manager": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-builder-bob": "^0.40.0",
    "typescript": "~5.9.2",
    "zod": "^3.25.76"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript"
      ]
    ]
  },
  "sideEffects": [
    "./src/webrtc/*",
    "./lib/*/webrtc/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/tejasvi8686/realtime-voice/issues"
  },
  "homepage": "https://github.com/tejasvi8686/realtime-voice#readme"
}
