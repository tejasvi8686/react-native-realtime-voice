# Keeps whitespace consistent across editors, so a contributor's editor does
# not reformat files it did not mean to touch.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Markdown uses trailing spaces for hard line breaks.
trim_trailing_whitespace = false
